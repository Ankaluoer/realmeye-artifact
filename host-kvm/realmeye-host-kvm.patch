--- a/arch/arm64/kvm/rme-exit.c
+++ b/arch/arm64/kvm/rme-exit.c
@@ -182,6 +182,44 @@ int handle_rec_exit(struct kvm_vcpu *vcpu, int rec_run_ret)
 	vcpu->arch.fault.hpfar_el2 = rec->run->exit.hpfar;
 
 	update_arch_timer_irq_lines(vcpu);
+	
+	 /* DEBUG: only log when ioctl is waiting */
+        if (rec->vmi_cmd_waiting) {
+                pr_err("KVM rec exit: waiting=1 gprs[0]=0x%llx exit_reason=%u\n",
+                       (unsigned long long)rec->run->exit.gprs[0],
+                       rec->run->exit.exit_reason);
+        }
+		
+	/* VMI cmd: copy result from RMM and wake up ioctl waiter */
+        if (rec->vmi_cmd_waiting) {
+                rec->vmi_result_val = rec->run->exit.gprs[0];
+                rec->vmi_result_status = 0;
+                rec->vmi_cmd_done = true;
+                rec->vmi_cmd_waiting = false;
+                /* clear so the next exit doesn't see stale data */
+                rec->run->exit.gprs[0] = 0;
+                wake_up(&rec->vmi_wait);
+        }
+
+	/* Check for VMI scan results */
+        {
+                u8 *enc = rec->run->exit.vmi_encrypted;
+                bool has_result = false;
+                int i;
+                for (i = 0; i < 16; i++) {
+                        if (enc[i] != 0) { has_result = true; break; }
+                }
+                if (has_result) {
+                        pr_info("VMI encrypted result received: "
+                                "%02x%02x%02x%02x%02x%02x%02x%02x"
+                                "%02x%02x%02x%02x%02x%02x%02x%02x\n",
+                                enc[0],enc[1],enc[2],enc[3],
+                                enc[4],enc[5],enc[6],enc[7],
+                                enc[8],enc[9],enc[10],enc[11],
+                                enc[12],enc[13],enc[14],enc[15]);
+                        memset(enc, 0, 16);
+                }
+        }
 
 	/* Reset the emulation flags for the next run of the REC */
 	rec->run->enter.flags = 0;
diff --git a/arch/arm64/kvm/rme.c b/arch/arm64/kvm/rme.c
index d8e0a447e..5266ab90a 100644
--- a/arch/arm64/kvm/rme.c
+++ b/arch/arm64/kvm/rme.c
@@ -1434,10 +1434,72 @@ int kvm_rec_enter(struct kvm_vcpu *vcpu)
 	if (kvm_realm_state(vcpu->kvm) != REALM_STATE_ACTIVE)
 		return -EINVAL;
 
+	/* VMI: set scan flag if requested */
+        if (rec->vmi_scan_pending) {
+                rec->vmi_scan_pending = false;
+                rec->run->enter.flags |= REC_ENTER_FLAG_VMI_SCAN;
+                pr_info("VMI scan flag set in rec_run entry\n");
+        }
+
+	/* VMI CMD: pass command via rec_run entry flags + gprs */
+        if (rec->vmi_cmd_pending) {
+                rec->vmi_cmd_pending = false;
+                rec->vmi_cmd_waiting = true;
+		rec->run->enter.flags |= REC_ENTER_FLAG_VMI_SCAN;
+                rec->run->enter.gprs[0] = rec->vmi_cmd_type;
+                rec->run->enter.gprs[1] = rec->vmi_cmd_arg0;
+                pr_err("VMI CMD[%d] arg0=0x%llx set in rec_run entry\n",
+                       rec->vmi_cmd_type, rec->vmi_cmd_arg0);
+        }	
+
 	return rmi_rec_enter(virt_to_phys(rec->rec_page),
 			     virt_to_phys(rec->run));
 }
 
+int kvm_vmi_scan_procs(struct kvm_vcpu *vcpu)
+{
+        struct realm_rec *rec = &vcpu->arch.rec;
+
+        if (kvm_realm_state(vcpu->kvm) != REALM_STATE_ACTIVE)
+                return -EINVAL;
+
+	return rmi_vmi_scan_procs(virt_to_phys(rec->rec_page),
+                                  virt_to_phys(rec->run));
+}
+
+int kvm_cca_vmi_dispatch(struct kvm_vcpu *vcpu, struct kvm_cca_vmi_cmd *cmd)
+{
+        struct realm_rec *rec = &vcpu->arch.rec;
+        int ret;
+        unsigned long out_val = 0;
+
+        if (kvm_realm_state(vcpu->kvm) != REALM_STATE_ACTIVE)
+                return -EINVAL;
+
+        /* For FULL_SCAN, use simple call */
+        if (cmd->cmd == CCA_VMI_CMD_FULL_SCAN) {
+                ret = rmi_vmi_scan_procs(virt_to_phys(rec->rec_page),
+                                         virt_to_phys(rec->run));
+                cmd->status = ret;
+                return ret ? -EIO : 0;
+        }
+
+        /* Fine-grained VMI command */
+        ret = rmi_vmi_scan_procs_ex(virt_to_phys(rec->rec_page),
+                                     virt_to_phys(rec->run),
+                                     cmd->cmd,
+                                     cmd->addr ? cmd->addr : cmd->reg_id,
+                                     &out_val);
+
+        cmd->status = ret;
+        if (ret)
+                return -EIO;
+
+        cmd->result_val = out_val;
+        cmd->result_size = 8;
+        return 0;
+}
