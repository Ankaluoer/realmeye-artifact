+/**
+ * rmi_vmi_scan_procs() - Trigger VMI process scan
+ * @rec: PA of the target REC
+ * @run_ptr: PA of RecRun structure
+ *
+ * Triggers a VMI process list scan from the RMM.
+ *
+ * Return: RMI return code
+ */
+static inline int rmi_vmi_scan_procs_ex(unsigned long rec, unsigned long run_ptr,
+                                        unsigned long cmd, unsigned long arg0,
+                                        unsigned long *out_val)
+{
+        struct arm_smccc_res res;
+        arm_smccc_1_1_invoke(SMC_RMI_VMI_SCAN_PROCS, rec, run_ptr,
+                             cmd, arg0, &res);
+        if (out_val)
+                *out_val = res.a1;
+        return res.a0;
+}
+
+static inline int rmi_vmi_scan_procs(unsigned long rec, unsigned long run_ptr)
+{
+        return rmi_vmi_scan_procs_ex(rec, run_ptr, 0, 0, NULL);
+}
