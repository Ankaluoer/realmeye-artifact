+	case KVM_ARM_CCA_VMI_VM: {
+		struct kvm_cca_vmi_cmd cmd;
+		int r;
+
+		if (copy_from_user(&cmd, argp, sizeof(cmd)))
+			return -EFAULT;
+		r = kvm_cca_vmi_vm_ioctl(&cmd);
+		/* Always copy back so userspace gets cmd.status even on error. */
+		if (copy_to_user(argp, &cmd, sizeof(cmd)))
+			return -EFAULT;
+		return r;
+	}
+	default:
+		return -EINVAL;
+	}
 }
 
