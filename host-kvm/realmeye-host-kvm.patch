+/*
+ * VMI: find the (single) realm VM in the system and dispatch a VMI command
+ * synchronously via the rec_run.enter flag channel. Blocks until the result
+ * comes back from RMM (via handle_rec_exit waking us up) or timeout.
+ *
+ * Assumption: at most one realm VM exists at any time.
+ */
+static int kvm_cca_vmi_vm_ioctl(struct kvm_cca_vmi_cmd *cmd)
+{
+	struct kvm *kvm, *target_kvm = NULL;
+	struct kvm_vcpu *vcpu;
+	struct realm_rec *rec;
+	long timeout;
+	int ret = 0;
+
+	/* Find the realm VM. */
+	mutex_lock(&kvm_lock);
+	list_for_each_entry(kvm, &vm_list, vm_list) {
+		if (kvm_is_realm(kvm)) {
+			target_kvm = kvm;
+			kvm_get_kvm(target_kvm);
+			break;
+		}
+	}
+	mutex_unlock(&kvm_lock);
+
+	if (!target_kvm) {
+		cmd->status = -ENODEV;
+		return -ENODEV;
+	}
+
+	if (kvm_realm_state(target_kvm) != REALM_STATE_ACTIVE) {
+		ret = -ENOTCONN;
+		cmd->status = ret;
+		goto out_put;
+	}
+
+	vcpu = kvm_get_vcpu(target_kvm, 0);
+	if (!vcpu) {
+		ret = -ENOENT;
+		cmd->status = ret;
+		goto out_put;
+	}
+
+	rec = &vcpu->arch.rec;
+
+	/* Set up the pending command and arm the waiter. */
+	rec->vmi_cmd_done = false;
+	rec->vmi_cmd_type = cmd->cmd;
+	rec->vmi_cmd_arg0 = cmd->addr ? cmd->addr : cmd->reg_id;
+	rec->vmi_cmd_pending = true;
+
+	/* Kick the vcpu so it exits the realm and runs kvm_rec_enter soon. */
+	kvm_vcpu_kick(vcpu);
+
+	/* Block until handle_rec_exit signals completion, or 5 seconds elapse. */
+	timeout = wait_event_interruptible_timeout(rec->vmi_wait,
+						   rec->vmi_cmd_done,
+						   60 * HZ);
+	if (timeout == 0) {
+		/* Timed out. Tear down the pending state so it isn't applied later. */
+		rec->vmi_cmd_pending = false;
+		rec->vmi_cmd_waiting = false;
+		ret = -ETIMEDOUT;
+		cmd->status = ret;
+		goto out_put;
+	}
+	if (timeout < 0) {
+		/* Interrupted by signal. */
+		rec->vmi_cmd_pending = false;
+		rec->vmi_cmd_waiting = false;
+		ret = -EINTR;
+		cmd->status = ret;
+		goto out_put;
+	}
+
+	/* Success: copy the result. */
+	cmd->status = rec->vmi_result_status;
+	cmd->result_val = rec->vmi_result_val;
+	cmd->result_size = 8;
+	ret = 0;
+
+out_put:
+	kvm_put_kvm(target_kvm);
+	return ret;
+}
+
